Algoritmo ejercicio3
	Definir letra Como Caracter
	Definir palabra Como Cadena
	Definir nletra Como Real
	Definir i Como Entero
	
	Escribir "Introduzca una cadena"
	Leer palabra
	Escribir "Introduzca un caracter"
	Leer letra
	
	nletra<- 0

	Para i <- 0 Hasta Longitud(palabra) Hacer
		Si Subcadena(palabra, i, i) = letra Entonces
			nletra <- nletra + 1
		Fin Si
	Fin Para
    Escribir "La letra " letra " aparece " nletra " veces"
FinAlgoritmo
